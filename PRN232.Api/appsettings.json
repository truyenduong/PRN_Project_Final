{
  "ConnectionStrings": {
    "WorkflowHub": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres"
  },
  "Database": {
    "Schema": "workflow"
  },
  "Security": {
    "Jwt": {
      "Issuer": "WorkFlowHub",
      "AccessTokenExpiration": 1800000,
      "RefreshTokenExpiration": 604800000
    }
  },
  "Cors": {
    "AllowedOriginPatterns": [ "*" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH", "HEAD" ],
    "AllowedHeaders": [ "*" ],
    "ExposedHeaders": [ "Authorization", "Content-Type" ],
    "AllowCredentials": true
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "Password": "",
    "SslEnabled": false,
    "TimeoutMilliseconds": 5000,
    "CacheTimeToLiveMilliseconds": 60000
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "SecurityProtocol": "PLAINTEXT",
    "SaslMechanism": "SCRAM-SHA-256",
    "SaslJaasConfig": "",
    "ConsumerGroup": "workflowhub-notification-group"
  },
  "Pagination": {
    "DefaultPage": 0,
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "DefaultSortField": "createdAt"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Urls": "http://localhost:8080",
  "AllowedHosts": "*"
}
